{
  "name": "samestory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/build-worker.mjs && next dev --webpack --port 5173",
    "build": "node scripts/build-worker.mjs && next build --webpack",
    "start": "next start --port 5173",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/news-engine.test.ts tests/backend.test.ts tests/database.test.ts",
    "typecheck": "tsc --noEmit",
    "db:seed": "node --env-file=.env.local --experimental-strip-types scripts/seed-supabase.ts",
    "eval:lsh": "node --experimental-strip-types scripts/evaluate-lsh.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "@electric-sql/pglite": "0.5.16"
  },
  "type": "module"
}
