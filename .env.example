# Copy to .env.local for local development. Public values also need Vercel build-time envs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only needed for the optional local seed script. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# 팀 기본 요약은 Z.ai Chat Completions다. 키와 모델을 모두 넣으면 OpenAI보다 먼저 사용한다.
# 비용 확인 후 모델을 적는다. 문서의 경량 예: glm-5.3-flash
ZAI_API_KEY=
ZAI_MODEL=

# Z.ai 키가 없을 때 쓰는 OpenAI Responses API. 사용자는 workspace_members admin/tester 역할이 필요하다.
OPENAI_API_KEY=
OPENAI_MODEL=
