# Copy to .env.local for local development. Public values also need Vercel build-time envs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only needed for the optional local seed script. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Optional AI summarizer. Users also need workspace_members admin/tester role.
OPENAI_API_KEY=
OPENAI_MODEL=
